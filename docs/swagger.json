            },
            "example": 1
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateOrderRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "更新成功"
          },
          "400": {
            "description": "參數驗證失敗、重複商品或庫存不足",
